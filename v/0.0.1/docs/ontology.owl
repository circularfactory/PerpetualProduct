                    <rdf:Description rdf:about="https://w3id.org/circularfactory/PerpetualProduct#PrincipleVariation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label>composed of type</rdfs:label>
