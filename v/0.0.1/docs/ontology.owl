        <rdfs:domain rdf:resource="https://w3id.org/circularfactory/PerpetualProduct#Variation"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/circularfactory/Core#Assembly"/>
                    <rdf:Description rdf:about="https://w3id.org/circularfactory/Core#Component"/>
