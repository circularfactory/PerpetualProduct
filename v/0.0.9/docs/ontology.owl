<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/circularfactory/PerpetualProduct#"
     xml:base="https://w3id.org/circularfactory/PerpetualProduct"
     xmlns:mod="https://w3id.org/mod#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/circularfactory/PerpetualProduct">
        <owl:versionIRI rdf:resource="https://w3id.org/circularfactory/PerpetualProduct/0.0.9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-28</terms:created>
        <terms:creator rdf:resource="https://orcid.org/0009-0002-4321-3391"/>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="en">The Circular Factory Product Ontology</terms:title>
        <vann:preferredNamespacePrefix>product</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://w3id.org/circularfactory/PerpetualProduct#"/>
        <rdfs:comment xml:lang="en">The product ontology defines central concepts and relations of the product within the circular factory.</rdfs:comment>
        <rdfs:label xml:lang="en">Circular Factory Product Ontology</rdfs:label>
        <owl:versionInfo>0.0.9</owl:versionInfo>
        <mod:createdWith rdf:resource="https://chowlk.linkeddata.es/"/>
    </owl:Ontology>
    


