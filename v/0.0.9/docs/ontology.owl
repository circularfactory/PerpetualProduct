                    <rdf:Description rdf:about="https://w3id.org/circularfactory/PerpetualProduct#ReferenceData"/>
                    <rdf:Description rdf:about="https://w3id.org/circularfactory/PerpetualProduct#UsageHistory"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label>embodiment degradation composed of</rdfs:label>
    </owl:ObjectProperty>
    


